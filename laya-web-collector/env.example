# Local development defaults to SQLite.  For Alibaba Cloud, use the private
# PostgreSQL/RDS/Supabase connection string supplied by your deployment.
# Hosted Supabase production variables are documented in deploy/env.supabase.example
APP_ENV=development
DATABASE_URL=sqlite:///./local_pilot.sqlite3
# Example Alibaba Cloud RDS / self-hosted Supabase Postgres:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@PRIVATE_HOST:5432/laya_pilot?sslmode=require

EXPORT_DIR=./exports
AUTO_SEED_DEMO=1
AUTH_MODE=disabled
AUTH_GATEWAY_SECRET=replace_with_a_long_random_gateway_secret
CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# Randomization. Leave RANDOMIZATION_DETERMINISTIC_SEED unset in the pilot so
# every encounter gets a fresh secret seed.
# RANDOMIZATION_DETERMINISTIC_SEED=20260928
RANDOMIZATION_STRATEGY=stratified_simple
RANDOMIZATION_BLOCK_SIZES=3,6
RANDOMIZATION_SCHEDULE_VERSION=target-fact-stratified-simple-v2
RANDOMIZATION_TARGET_PER_ARM=30
ADJUDICATION_REVIEWS_REQUIRED=2
REQUIRE_CONSENSUS_FOR_EXPORT=1
REQUIRE_SPLIT_METADATA=0
LABEL_CODEBOOK_VERSION=real-pilot-label-v1
PATIENT_LINK_TTL_MINUTES=4320
QUESTION_EXPIRY_MINUTES=4320
ASYNC_WORKER_POLL_SECONDS=5
# OpenAI-compatible LLM endpoint (DeepSeek example).
# Keep this key server-side only.  In production inject it through KMS or
# Secrets Manager instead of storing it in a file.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=replace_with_your_api_key
LLM_QUESTION_MODEL=deepseek-flash
LLM_EXTRACTOR_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_TOP_P=1.0
LLM_ENABLE_THINKING=0
LLM_JSON_MODE=1
