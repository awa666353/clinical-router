# Copy to supabase/.env for local migration/deployment work.
# Never commit the filled-in file.

# Run pass 1/3 as postgres:
MIGRATION_DATABASE_URL='postgresql://postgres:<postgres-password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require'

# Run pass 2 as laya_app through the Supabase session pooler:
LAYA_APP_DATABASE_URL='postgresql://laya_app.<project-ref>:<laya-app-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require'
LAYA_APP_PASSWORD='<laya-app-password>'
