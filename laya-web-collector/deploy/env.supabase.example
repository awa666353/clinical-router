# Supabase / production environment template for the hosted collector (W9).
#
# Copy to the deployment host, fill in the placeholders, then lock it down:
#
#   sudo cp deploy/env.supabase.example /etc/laya/collector.env
#   sudo chown root:root /etc/laya/collector.env
#   sudo chmod 600 /etc/laya/collector.env
#
# /etc/laya/collector.env is read by the `api` and `worker` services only
# (see compose.supabase.yml) and is NEVER committed to Git.  Caddy does not
# receive it.
#
# SECURITY: SUPABASE_SECRET_KEY is a server-only credential.  It bypasses RLS
# and can administer Storage/Auth, so it must never be sent to the browser,
# printed to logs, or stored anywhere in this repository.

# --- Environment / data governance -----------------------------------------
APP_ENV=production
ALLOW_REAL_PATIENT_DATA=0
LLM_PERSIST_RAW=0

# --- Database: Supavisor session pooler (IPv4), dedicated role, TLS ---------
# Copy <pooler-host> from Supabase Dashboard -> Connect -> Session pooler.
# Use the session pooler on port 5432, NOT the transaction pooler on 6543.
DATABASE_URL=postgresql+psycopg://laya_app.<project_ref>:<password>@<pooler-host>:5432/postgres?sslmode=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
# Production must never run create_all; schema comes from the migrations.
DB_AUTO_CREATE=0
DB_EXPECTED_SCHEMA=pilot

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable or legacy anon key>
# Server-only.  Prefer the new secret key; legacy service_role key also works.
# Loaded into api/worker env only, never into Caddy or the browser.
SUPABASE_SECRET_KEY=<secret or legacy service_role key>
# Legacy HS256 projects only; leave EMPTY to validate access tokens via JWKS.
SUPABASE_JWT_SECRET=

# --- Auth / storage ---------------------------------------------------------
AUTH_MODE=supabase
STORAGE_BACKEND=supabase
STORAGE_BUCKET=pilot-private
# Exactly the single public origin; no wildcard, no localhost in production.
CORS_ORIGINS=https://collector.<domain>
AUTO_SEED_DEMO=0

# --- LLM (server-side only; kept from the existing configuration) -----------
# Fill these in for real question generation/extraction.  Without a key the
# deterministic fallback extractor is used.
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=<server-only Bailian/DashScope key>
# LLM_QUESTION_MODEL=<question model name from env.example>
# LLM_EXTRACTOR_MODEL=<extractor model name from env.example>
# LLM_TIMEOUT_SECONDS=90
# LLM_MAX_TOKENS=2048
# LLM_TEMPERATURE=0.1
# LLM_TOP_P=1.0
# LLM_ENABLE_THINKING=0
# LLM_JSON_MODE=1
#
# W10 backup credentials are host-cron-only and belong in a separate root-owned
# file (/etc/laya/backup.env); see scripts/backup_postgres.sh and
# deploy/HOSTED_DEPLOYMENT.md.  Do not add backup secrets to this app env file.
